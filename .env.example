# Copy to .env and fill in. Never commit .env.

# --- Answer generation (required) ---
# Claude (Anthropic) API key: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional; default claude-sonnet-5-5
# LLM_MODEL=claude-sonnet-5-5

# --- Web server ---
# 127.0.0.1 = this computer only. Use 0.0.0.0 to share on a network (set APP_PASSWORD too).
FLASK_HOST=127.0.0.1
FLASK_PORT=8000
# Keep false unless on a trusted machine: debug mode exposes an interactive debugger
FLASK_DEBUG=false
# Optional password for the whole app (browser asks for it; any username). Empty = no password.
APP_PASSWORD=
# Optional comma-separated origins allowed to call the API from other sites. Empty = none.
CORS_ORIGINS=

# --- Vector store ---
CHROMA_DB_PATH=./chroma_db

# --- Retrieval (all optional; defaults shown) ---
# hybrid = dense + BM25 fused with RRF | dense = original semantic-only search | bm25
RETRIEVAL_MODE=hybrid
DENSE_TOP_K=30
BM25_TOP_K=30
RRF_K=60
# Chunks sent to the LLM
FINAL_TOP_K=10
BM25_INDEX_PATH=bm25_index/malayalam_docs.json.gz
BM25_AUTO_SYNC=true

# Cross-encoder reranking (falls back to hybrid ranking if the model cannot load)
RERANK_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=30
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=8
# int8 = ~2.4x faster on CPU (default); none = full precision (GPUs always use full precision)
RERANK_QUANTIZE=int8
# RERANKER_DEVICE=cpu
